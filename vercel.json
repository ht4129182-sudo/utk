{
    "services": {
        "frontend": {
            "root": "frontend",
            "srcDir": "src",
            "framework": "vite",
            "buildCommand": "npm install && npm run build",
            "outputDirectory": "dist"
        },
        "backend": {
            "root": "backend",
            "framework": "express",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
